{
  "name": "@hiq-ai/hiq-editor",
  "version": "0.7.0",
  "description": "HiQ LCA dataset editor client — the `hiq-editor` CLI (schema-driven subcommands + whole-UPR `import` with checkpoint/resume) and a stdio MCP gateway (`hiq-editor-mcp`) that re-exposes the editor server's tools, plus local UPR-template / file tools.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hiq-editor-mcp": "./dist/server.js",
    "hiq-editor": "./dist/cli.js"
  },
  "exports": {
    "./mcp": "./dist/server.js",
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "qrcode-terminal": "^0.12.0",
    "xlsx": "^0.18.5",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/yargs": "^17.0.32",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiQ-AI/hiq-editor.git"
  },
  "homepage": "https://github.com/HiQ-AI/hiq-editor#readme",
  "bugs": "https://github.com/HiQ-AI/hiq-editor/issues",
  "keywords": [
    "cli",
    "mcp",
    "lca",
    "carbon-footprint",
    "hiq",
    "editor",
    "cortex"
  ]
}
