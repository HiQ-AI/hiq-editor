{
  "name": "@hiq-ai/hiq-editor",
  "version": "0.11.0",
  "description": "HiQ LCA dataset editor client — an agent-oriented CLI over the native Editor API, with an optional stdio MCP adapter.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hiq-editor-mcp": "./dist/server.js",
    "hiq-editor": "./dist/cli.js"
  },
  "exports": {
    "./mcp": "./dist/server.js",
    "./commands": {
      "import": "./dist/commands.js",
      "types": "./dist/commands.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build",
    "prebuild": "node scripts/stamp-version.mjs",
    "build:bin": "./scripts/build-binaries.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "exceljs": "^4.4.0",
    "qrcode-terminal": "^0.12.0",
    "yargs": "^18.0.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/yargs": "^17.0.32",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiQ-AI/hiq-editor.git"
  },
  "homepage": "https://github.com/HiQ-AI/hiq-editor#readme",
  "bugs": "https://github.com/HiQ-AI/hiq-editor/issues",
  "keywords": [
    "cli",
    "mcp",
    "lca",
    "carbon-footprint",
    "hiq",
    "editor",
    "cortex"
  ]
}
